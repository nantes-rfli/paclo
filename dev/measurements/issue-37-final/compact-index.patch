@@ -129,0 +130,14 @@
+(defn- index-key [index until k]
+  (assoc index until (if-let [existing (get index until)]
+                      (if (vector? existing) (conj existing k) [existing k])
+                      k)))
+
+(defn- retired-index [state]
+  ;; EDN maps lose their sorted type; legacy snapshots have no index at all.
+  (let [index (::retired-expiries state)]
+    (cond
+      (sorted? index) index
+      (some? index) (into (sorted-map) index)
+      :else (reduce-kv (fn [index k until] (index-key index until k))
+                       (sorted-map) (:retired state)))))
+
@@ -137 +151,2 @@
-      (-> (assoc-in [:retired k] until) (schedule until)))))
+      (-> (assoc ::retired-expiries (index-key (retired-index state) until k))
+          (assoc-in [:retired k] until) (schedule until)))))
@@ -206,11 +221,10 @@
